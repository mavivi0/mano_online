#!/usr/bin/env python3
"""Build the CV in cv/ from content/.

  content/profile.yml + content/cv.yml + cv/template.tex  ->  cv/main.tex
  content/papers.bib                                       ->  cv/main.bib
  latexmk (moderncv + biblatex)                            ->  cv/main.pdf

Jekyll runs this automatically (see _plugins/content.rb); run it by hand to get the
CV on its own:

    bin/build-cv                        # writes cv/main.tex, cv/main.bib, cv/main.pdf
    bin/build-cv --out ~/Desktop/cv.pdf # ...and also copies the PDF there

Needs: python3 -m pip install -r requirements.txt, and a TeX distribution with
latexmk, moderncv and biblatex (on a Mac: MacTeX, or `brew install --cask mactex-no-gui`).
"""

import argparse
import re
import shutil
import subprocess
import sys
from pathlib import Path

import jinja2
import yaml
from pybtex.database import parse_file

ROOT = Path(__file__).resolve().parent.parent
CONTENT = ROOT / "content"
CV = ROOT / "cv"

GENERATED = "% Generated by bin/build-cv from {}. Do not edit: change content/ (or cv/template.tex) instead.\n"

# papers.bib fields that only the website uses (al-folio buttons, badges, previews).
WEB_ONLY_FIELDS = {
    "abbr", "additional_info", "altmetric", "award", "award_name", "bibtex_show", "blog", "code", "dimensions",
    "google_scholar_id", "html", "inspirehep_id", "pdf", "poster", "preview", "selected", "slides", "supp", "video",
    "website",
}
MONTHS = "jan feb mar apr may jun jul aug sep oct nov dec".split()

LATEX_SPECIALS = {
    "\\": r"\textbackslash{}", "&": r"\&", "%": r"\%", "$": r"\$", "#": r"\#", "_": r"\_",
    "{": r"\{", "}": r"\}", "~": r"\textasciitilde{}", "^": r"\textasciicircum{}",
}
# \cite{...} passes through; [text](url) becomes \href.
TOKEN = re.compile(r"(?P<cite>\\cite\{[^}]*\})|\[(?P<text>[^\]]+)\]\((?P<url>[^)\s]+)\)")


def escape(text):
    text = "".join(LATEX_SPECIALS.get(char, char) for char in text)
    text = re.sub(r"\*\*(.+?)\*\*", r"\\textbf{\1}", text)
    text = re.sub(r"\*(.+?)\*", r"\\emph{\1}", text)
    # A period after an abbreviation is not the end of a sentence.
    return re.sub(r"\b(Prof|Dr|vs|e\.g|i\.e)\. ", r"\1.\\ ", text)


def tex(value):
    """Text from content/ -> LaTeX."""
    if not value:
        return ""
    out, pos = [], 0
    text = " ".join(str(value).split())
    for match in TOKEN.finditer(text):
        out.append(escape(text[pos : match.start()]))
        if match["cite"]:
            out.append(match["cite"])
        else:
            url = match["url"].replace("%", r"\%").replace("#", r"\#")
            out.append(rf"\href{{{url}}}{{{escape(match['text'])}}}")
        pos = match.end()
    out.append(escape(text[pos:]))
    return "".join(out)


def dates(entry):
    if entry.get("date"):
        return tex(entry["date"])
    start, end = (str(entry.get(key) or "") for key in ("start_date", "end_date"))
    return start if not end or end == start else f"{start}--{end}"


def bullets(highlights):
    return "\n\\newline{}".join(f"- {tex(item)}" for item in highlights or [])


def description(entry):
    return "\n\\newline{}".join(part for part in (tex(entry.get("summary")), bullets(entry.get("highlights"))) if part)


def write_tex(profile, cv):
    env = jinja2.Environment(
        loader=jinja2.FileSystemLoader(CV),
        line_statement_prefix="%%",
        line_comment_prefix="%#",
        variable_start_string=r"\VAR{",
        variable_end_string="}",
        block_start_string=r"\BLOCK{",
        block_end_string="}",
        comment_start_string=r"\#{",
        comment_end_string="}",
        trim_blocks=True,
        lstrip_blocks=True,
        undefined=jinja2.ChainableUndefined,
    )
    env.filters.update(tex=tex, dates=dates, bullets=bullets, description=description)
    text = env.get_template("template.tex").render(profile=profile, sections=cv["sections"])
    (CV / "main.tex").write_text(GENERATED.format("cv/template.tex, content/profile.yml and content/cv.yml") + text)


def write_bib(name):
    bib = parse_file(CONTENT / name, bib_format="bibtex")
    for entry in bib.entries.values():
        fields = entry.fields
        for field in [f for f in fields if f.lower() in WEB_ONLY_FIELDS]:
            del fields[field]
        if "arxiv" in fields:
            fields["eprint"], fields["eprinttype"] = fields.pop("arxiv"), "arxiv"
        month = fields.get("month", "").strip().lower()[:3]
        if month in MONTHS:
            fields["month"] = str(MONTHS.index(month) + 1)
    (CV / "main.bib").write_text(GENERATED.format(f"content/{name}") + "\n" + bib.to_string("bibtex"))


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--out", type=Path, help="also copy the PDF here")
    out = parser.parse_args().out

    profile = yaml.safe_load((CONTENT / "profile.yml").read_text())
    cv = yaml.safe_load((CONTENT / "cv.yml").read_text())
    bibs = [entries for entries in cv["sections"].values() if isinstance(entries, str)]
    if len(bibs) != 1 or not bibs[0].endswith(".bib"):
        sys.exit("content/cv.yml needs exactly one `<Section>: <file>.bib` line, e.g. `Publications: papers.bib`")

    write_tex(profile, cv)
    write_bib(bibs[0])
    command = ["latexmk", "-pdf", "-interaction=nonstopmode", "-halt-on-error", "main.tex"]
    result = subprocess.run(command, cwd=CV, capture_output=True, text=True)
    if result.returncode != 0:
        log = (CV / "main.log").read_text(errors="replace") if (CV / "main.log").exists() else result.stdout
        errors = [line for line in log.splitlines() if line.startswith("!")] or log.splitlines()[-30:]
        sys.exit("LaTeX failed (full log: cv/main.log):\n" + "\n".join(errors))

    if out:
        out.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(CV / "main.pdf", out)
    print("Wrote cv/main.tex, cv/main.bib, cv/main.pdf" + (f" and {out}" if out else ""))


if __name__ == "__main__":
    main()
